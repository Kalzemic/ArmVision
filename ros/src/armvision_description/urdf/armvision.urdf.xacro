<?xml version='1.0'?>


<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="armvision">

    <!-- <xacro:include filename="$(find armvision_description)/urdf/sensors.xacro" /> -->
    <!-- <xacro:include filename="$(find armvision_description)/urdf/armvision_ros2_control.xacro"
    /> -->
    <xacro:property name="PI" value="3.14159" />
    <xacro:property name="effort" value="30.0" />
    <xacro:property name="velocity" value="10.0" />

    <!-- Solid box approximation: x y z are the box dimensions, com is the center of mass -->
    <xacro:macro name="box_inertial" params="mass x y z com">
        <inertial>
            <origin rpy="0 0 0" xyz="${com}" />
            <mass value="${mass}" />
            <inertia ixx="${mass / 12.0 * (y*y + z*z)}" ixy="0.0" ixz="0.0"
                iyy="${mass / 12.0 * (x*x + z*z)}" iyz="0.0"
                izz="${mass / 12.0 * (x*x + y*y)}"
            />
        </inertial>
    </xacro:macro>
    <link name="world" />

    <link name="base_link">
        <xacro:box_inertial mass="1.0" x="0.3" y="0.3" z="0.3" com="0 0 0.15" />
        <visual>
            <origin rpy="0 0 0" xyz="-0.5 -0.5 0" />
            <geometry>
                <mesh filename="package://armvision_description/meshes/basement.STL"
                    scale="0.01 0.01 0.01" />
            </geometry>
        </visual>
        <collision>
            <origin rpy="0 0 0" xyz="-0.5 -0.5 0" />
            <geometry>
                <mesh filename="package://armvision_description/meshes/basement.STL"
                    scale="0.01 0.01 0.01" />
            </geometry>
        </collision>
    </link>

    <joint name="virtual_joint" type="fixed">
        <parent link="world" />
        <child link="base_link" />
        <origin rpy="0 0 0" xyz="0 0 0" />
    </joint>


    <link name="base_plate">
        <xacro:box_inertial mass="0.1" x="0.2" y="0.2" z="0.35" com="0 0 0.175" />
        <visual>
            <origin rpy="0 0 0" xyz="-0.39 -0.39 -0.56" />
            <geometry>
                <mesh filename="package://armvision_description/meshes/base_plate.STL"
                    scale="0.01 0.01 0.01" />
            </geometry>
        </visual>
        <collision>
            <origin rpy="0 0 0" xyz="-0.39 -0.39 -0.56" />
            <geometry>
                <mesh filename="package://armvision_description/meshes/base_plate.STL"
                    scale="0.01 0.01 0.01" />
            </geometry>
        </collision>
    </link>

    <joint name="joint_1" type="revolute">
        <parent link="base_link" />
        <child link="base_plate" />
        <axis xyz="0 0 1" />
        <origin rpy="0 0 0" xyz="0 0 0.307" />
        <limit lower="-${PI/2}" upper="${PI/2}" effort="${effort}" velocity="${velocity}" />
    </joint>


    <link name="forward_drive_arm">
        <xacro:box_inertial mass="0.1" x="0.05" y="0.05" z="0.8" com="0 0 0.4" />
        <visual>
            <origin rpy="0 -${PI/2} ${PI/2}" xyz="0.19 0.06 -0.08" />
            <geometry>
                <mesh filename="package://armvision_description/meshes/forward_drive_arm.STL"
                    scale="0.01 0.01 0.01" />
            </geometry>
        </visual>
        <collision>
            <origin rpy="0 -${PI/2} ${PI/2}" xyz="0.19 0.06 -0.08" />
            <geometry>
                <mesh filename="package://armvision_description/meshes/forward_drive_arm.STL"
                    scale="0.01 0.01 0.01" />
            </geometry>
        </collision>
    </link>

    <joint name="joint_2" type="revolute">
        <parent link="base_plate" />
        <child link="forward_drive_arm" />
        <axis xyz="1 0 0" />
        <origin rpy="0 0 0" xyz="-0.02 0 0.35" />
        <limit lower="-${PI/2}" upper="${PI/2}" effort="${effort}" velocity="${velocity}" />
    </joint>

    <link name="horizontal_arm">
        <xacro:box_inertial mass="0.1" x="0.05" y="0.82" z="0.05" com="0 0.41 0" />
        <visual>
            <origin rpy="${PI/2} 0 ${PI/2}" xyz="-0.03 -0.4 -0.06" />
            <geometry>
                <mesh filename="package://armvision_description/meshes/horizontal_arm.STL"
                    scale="0.01 0.01 0.01" />
            </geometry>
        </visual>
        <collision>
            <origin rpy="${PI/2} 0 ${PI/2}" xyz="-0.03 -0.4 -0.06" />
            <geometry>
                <mesh filename="package://armvision_description/meshes/horizontal_arm.STL"
                    scale="0.01 0.01 0.01" />
            </geometry>
        </collision>
    </link>

    <joint name="joint_3" type="revolute">
        <parent link="forward_drive_arm" />
        <child link="horizontal_arm" />
        <axis xyz="1 0 0" />
        <origin rpy="0 0 0" xyz="0 0 0.8" />
        <limit lower="-${PI/2}" upper="${PI/2}" effort="${effort}" velocity="${velocity}" />
    </joint>

    <link name="claw_support">
        <xacro:box_inertial mass="0.05" x="0.1" y="0.1" z="0.1" com="0 0 0" />
        <visual>
            <origin rpy="0 0 ${PI/2}" xyz="0 -0.05 -0.15" />
            <geometry>
                <mesh filename="package://armvision_description/meshes/claw_support.STL"
                    scale="0.01 0.01 0.01" />
            </geometry>
        </visual>
        <collision>
            <origin rpy="0 0 ${PI/2}" xyz="0 -0.05 -0.15" />
            <geometry>
                <mesh filename="package://armvision_description/meshes/claw_support.STL"
                    scale="0.01 0.01 0.01" />
            </geometry>
        </collision>
    </link>

    <joint name="horizontal_arm_to_claw_support" type="fixed">
        <parent link="horizontal_arm" />
        <child link="claw_support" />
        <origin rpy="0 0 0" xyz="0 0.82 0" />
    </joint>

    <link name="gripper_right">
        <xacro:box_inertial mass="0.01" x="0.02" y="0.1" z="0.02" com="0 0 0" />
        <visual>
            <origin rpy="0 0 -${PI/2}" xyz="-0.1 0.5 -0.1" />
            <geometry>
                <mesh filename="package://armvision_description/meshes/right_finger.STL"
                    scale="0.01 0.01 0.01" />
            </geometry>
        </visual>
        <collision>
            <origin rpy="0 0 -${PI/2}" xyz="-0.1 0.5 -0.1" />
            <geometry>
                <mesh filename="package://armvision_description/meshes/right_finger.STL"
                    scale="0.01 0.01 0.01" />
            </geometry>
        </collision>
    </link>

    <link name="gripper_left">
        <xacro:box_inertial mass="0.01" x="0.02" y="0.1" z="0.02" com="0 0 0" />
        <visual>
            <origin rpy="0 0 -${PI/2}" xyz="-0.04 0.5 -0.1" />
            <geometry>
                <mesh filename="package://armvision_description/meshes/left_finger.STL"
                    scale="0.01 0.01 0.01" />
            </geometry>
        </visual>
        <collision>
            <origin rpy="0 0 -${PI/2}" xyz="-0.04 0.5 -0.1" />
            <geometry>
                <mesh filename="package://armvision_description/meshes/left_finger.STL"
                    scale="0.01 0.01 0.01" />
            </geometry>
        </collision>
    </link>

    <joint name="joint_4" type="fixed">

        <parent link="claw_support" />
        <child link="gripper_right" />
        <axis xyz="0 0 1" />
        <origin rpy="0 0 0" xyz="0.04 0.13 -0.1" />
        <!-- <limit lower="-${PI/2}" upper="0.0" effort="${effort}" velocity="${velocity}" /> -->
    </joint>
    <joint name="joint_5" type="fixed">
        <parent link="claw_support" />
        <child link="gripper_left" />
        <axis xyz="0 0 1" />
        <origin rpy="0 0 0" xyz="-0.22 0.13 -0.1" />
        <!-- <mimic joint="joint_4" multiplier="-1" />
        <limit lower="0.0" upper="${PI/2}" effort="${effort}" velocity="${velocity}" /> -->
    </joint>

    <link name="end_effector" />

    <joint name="claw_support_to_end_effector" type="fixed">
        <parent link="claw_support" />
        <child link="end_effector" />
        <origin xyz="-0.09 0.13 -0.1" rpy="0 0 0" />
    </joint>


    <link name="rgb_camera">
        <xacro:box_inertial mass="0.001" x="0.03" y="0.03" z="0.03" com="0 0 0" />
        <visual>
            <origin rpy="-${PI/2} 0 0" xyz="-0.125 0 0.34" />
            <geometry>
                <mesh filename="package://armvision_description/meshes/pi_camera.STL"
                    scale="0.01 0.01 0.01" />
            </geometry>
        </visual>
    </link>

    <joint name="claw_to_camera" type="fixed">
        <parent link="claw_support" />
        <child link="rgb_camera" />
        <origin xyz="0 -0.1 0.05" rpy="0 0 0" />
    </joint>


</robot>