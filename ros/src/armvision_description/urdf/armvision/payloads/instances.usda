#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    upAxis = "Z"
)

def Scope "Instances"
{
    def Xform "basement" (
        prepend references = @./geometries.usd@</Geometries/basement>
    )
    {
        over "basement"
        {
        }
    }

    def Xform "basement_1" (
        prepend references = @./geometries.usd@</Geometries/basement>
    )
    {
        over "basement" (
            apiSchemas = ["PhysicsCollisionAPI", "NewtonCollisionAPI", "PhysicsMeshCollisionAPI", "NewtonMeshCollisionAPI"]
        )
        {
            token physics:approximation = "convexHull"
            token purpose = "guide"
        }
    }

