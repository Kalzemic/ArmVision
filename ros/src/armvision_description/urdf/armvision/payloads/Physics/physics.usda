#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "armvision"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    upAxis = "Z"
)

over "armvision"
{
    over "Geometry"
    {
        over "world"
        {
            over "base_link" (
                prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsArticulationRootAPI", "NewtonArticulationRootAPI", "PhysicsMassAPI", "NewtonMassAPI"]
            )
            {
                double[] newton:inertia = [1, 1, 1, 0, 0, 0]
                bool newton:selfCollisionEnabled = 0
                float3 physics:diagonalInertia = (1, 1, 1)
                float physics:mass = 1
                quatf physics:principalAxes = (1, 0, 0, 0)

                over "base_plate" (
                    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "NewtonMassAPI"]
                )
                {
                    double[] newton:inertia = [1, 1, 1, 0, 0, 0]
                    float3 physics:diagonalInertia = (1, 1, 1)
                    float physics:mass = 0.1
                    quatf physics:principalAxes = (1, 0, 0, 0)

                    over "forward_drive_arm" (
                        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "NewtonMassAPI"]
                    )
                    {
                        double[] newton:inertia = [1, 1, 1, 0, 0, 0]
                        float3 physics:diagonalInertia = (1, 1, 1)
                        float physics:mass = 0.1
                        quatf physics:principalAxes = (1, 0, 0, 0)

                        over "horizontal_arm" (
                            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "NewtonMassAPI"]
                        )
                        {
                            double[] newton:inertia = [1, 1, 1, 0, 0, 0]
                            float3 physics:diagonalInertia = (1, 1, 1)
                            float physics:mass = 0.1
                            quatf physics:principalAxes = (1, 0, 0, 0)

                            over "claw_support" (
                                prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "NewtonMassAPI"]
                            )
                            {
                                double[] newton:inertia = [1, 1, 1, 0, 0, 0]
                                float3 physics:diagonalInertia = (1, 1, 1)
                                float physics:mass = 0.05
                                quatf physics:principalAxes = (1, 0, 0, 0)

                                over "gripper_right" (
                                    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "NewtonMassAPI"]
                                )
                                {
                                    double[] newton:inertia = [1, 1, 1, 0, 0, 0]
                                    float3 physics:diagonalInertia = (1, 1, 1)
                                    float physics:mass = 0.01
                                    quatf physics:principalAxes = (1, 0, 0, 0)
                                }

                                over "gripper_left" (
                                    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "NewtonMassAPI"]
                                )
                                {
                                    double[] newton:inertia = [1, 1, 1, 0, 0, 0]
                                    float3 physics:diagonalInertia = (1, 1, 1)
                                    float physics:mass = 0.01
                                    quatf physics:principalAxes = (1, 0, 0, 0)
                                }

                                over "rgb_camera" (
                                    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "NewtonMassAPI"]
                                )
                                {
                                    double[] newton:inertia = [1, 1, 1, 0, 0, 0]
                                    float3 physics:diagonalInertia = (1, 1, 1)
                                    float physics:mass = 0.001
                                    quatf physics:principalAxes = (1, 0, 0, 0)
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    over "Physics"
    {
        def PhysicsRevoluteJoint "joint_1" (
            prepend apiSchemas = ["NewtonJointAPI", "PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
        )
        {
            float drive:angular:physics:maxForce = 30
            float newton:velocityLimit = 572.9578
            uniform token physics:axis = "Z"
            custom rel physics:body0
            append rel physics:body0 = </armvision/Geometry/world/base_link>
            custom rel physics:body1
            append rel physics:body1 = </armvision/Geometry/world/base_link/base_plate>
            point3f physics:localPos0 = (0, 0, 0.307)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            float physics:lowerLimit = -89.99992
            float physics:upperLimit = 89.99992
            custom float urdf:limit:effort = 30
        }

        def PhysicsRevoluteJoint "joint_2" (
            prepend apiSchemas = ["NewtonJointAPI", "PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
        )
        {
            float drive:angular:physics:maxForce = 30
            float newton:velocityLimit = 572.9578
            uniform token physics:axis = "X"
            custom rel physics:body0
            append rel physics:body0 = </armvision/Geometry/world/base_link/base_plate>
            custom rel physics:body1
            append rel physics:body1 = </armvision/Geometry/world/base_link/base_plate/forward_drive_arm>
            point3f physics:localPos0 = (-0.02, 0, 0.35)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            float physics:lowerLimit = -89.99992
            float physics:upperLimit = 89.99992
            custom float urdf:limit:effort = 30
        }

        def PhysicsRevoluteJoint "joint_3" (
            prepend apiSchemas = ["NewtonJointAPI", "PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
        )
        {
            float drive:angular:physics:maxForce = 30
            float newton:velocityLimit = 572.9578
            uniform token physics:axis = "X"
            custom rel physics:body0
            append rel physics:body0 = </armvision/Geometry/world/base_link/base_plate/forward_drive_arm>
            custom rel physics:body1
            append rel physics:body1 = </armvision/Geometry/world/base_link/base_plate/forward_drive_arm/horizontal_arm>
            point3f physics:localPos0 = (0, 0, 0.8)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            float physics:lowerLimit = -89.99992
            float physics:upperLimit = 89.99992
            custom float urdf:limit:effort = 30
        }

        def PhysicsRevoluteJoint "joint_4" (
            prepend apiSchemas = ["NewtonJointAPI", "PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
        )
        {
            float drive:angular:physics:maxForce = 30
            float newton:velocityLimit = 572.9578
            uniform token physics:axis = "Z"
            custom rel physics:body0
            append rel physics:body0 = </armvision/Geometry/world/base_link/base_plate/forward_drive_arm/horizontal_arm/claw_support>
            custom rel physics:body1
            append rel physics:body1 = </armvision/Geometry/world/base_link/base_plate/forward_drive_arm/horizontal_arm/claw_support/gripper_right>
            point3f physics:localPos0 = (0.04, 0.13, -0.1)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            float physics:lowerLimit = -89.99992
            float physics:upperLimit = 0
            custom float urdf:limit:effort = 30
        }

        def PhysicsRevoluteJoint "joint_5" (
            prepend apiSchemas = ["NewtonJointAPI", "NewtonMimicAPI", "PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
        )
        {
            float drive:angular:physics:maxForce = 30
            float newton:mimicCoef1 = -1
            rel newton:mimicJoint = </armvision/Physics/joint_4>
            float newton:velocityLimit = 572.9578
            uniform token physics:axis = "Z"
            custom rel physics:body0
            append rel physics:body0 = </armvision/Geometry/world/base_link/base_plate/forward_drive_arm/horizontal_arm/claw_support>
            custom rel physics:body1
            append rel physics:body1 = </armvision/Geometry/world/base_link/base_plate/forward_drive_arm/horizontal_arm/claw_support/gripper_left>
            point3f physics:localPos0 = (-0.22, 0.13, -0.1)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            float physics:lowerLimit = 0
            float physics:upperLimit = 89.99992
            custom float urdf:limit:effort = 30
        }

        def PhysicsFixedJoint "virtual_joint"
        {
            custom rel physics:body0
            append rel physics:body0 = </armvision>
            custom rel physics:body1
            append rel physics:body1 = </armvision/Geometry/world/base_link>
            point3f physics:localPos0 = (0, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }

        def PhysicsFixedJoint "horizontal_arm_to_claw_support"
        {
            custom rel physics:body0
            append rel physics:body0 = </armvision/Geometry/world/base_link/base_plate/forward_drive_arm/horizontal_arm>
            custom rel physics:body1
            append rel physics:body1 = </armvision/Geometry/world/base_link/base_plate/forward_drive_arm/horizontal_arm/claw_support>
            point3f physics:localPos0 = (0, 0.82, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }

        def PhysicsFixedJoint "claw_to_camera"
        {
            custom rel physics:body0
            append rel physics:body0 = </armvision/Geometry/world/base_link/base_plate/forward_drive_arm/horizontal_arm/claw_support>
            custom rel physics:body1
            append rel physics:body1 = </armvision/Geometry/world/base_link/base_plate/forward_drive_arm/horizontal_arm/claw_support/rgb_camera>
            point3f physics:localPos0 = (0, -0.1, 0.05)
            point3f physics:localPos1 = (12.5, 34, -0.000044689892)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (0.09999518, 0.9949879, 0, 0)
        }
    }
}

