#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "armvision"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "armvision"
{
    over "Physics"
    {
        over "joint_1" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        over "joint_2" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        over "joint_3" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        def MjcActuator "joint_1_actuator"
        {
            uniform double mjc:forceRange:max = 30
            uniform double mjc:forceRange:min = -30
            custom rel mjc:target
            append rel mjc:target = </armvision/Physics/joint_1>
        }

        def MjcActuator "joint_2_actuator"
        {
            uniform double mjc:forceRange:max = 30
            uniform double mjc:forceRange:min = -30
            custom rel mjc:target
            append rel mjc:target = </armvision/Physics/joint_2>
        }

        def MjcActuator "joint_3_actuator"
        {
            uniform double mjc:forceRange:max = 30
            uniform double mjc:forceRange:min = -30
            custom rel mjc:target
            append rel mjc:target = </armvision/Physics/joint_3>
        }
    }
}

